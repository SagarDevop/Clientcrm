{
  "rewrites": [
    {
      "source": "/api/health",
      "destination": "/api/health.js"
    },
    {
      "source": "/api/send-email",
      "destination": "/api/send-email.js"
    },
    {
      "source": "/api/auth/:action",
      "destination": "/api/auth.js"
    },
    {
      "source": "/api/:resource/:id",
      "destination": "/api/data.js"
    },
    {
      "source": "/api/:resource",
      "destination": "/api/data.js"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
